{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Infrastructure Status & Golden Signals Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Application Availability (Uptime)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "up{job=\"ecommerce-backend\"}", "legendFormat": "Service Up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Database Connectivity Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "ecommerce_db_healthy", "legendFormat": "DB Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISCONNECTED", "color": "red" }, "1": { "text": "CONNECTED", "color": "green" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Active In-Flight Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "ecommerce_http_requests_in_flight", "legendFormat": "Active" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 15 }] } }
      }
    },
    {
      "id": 4,
      "title": "Total 4xx / 5xx Error Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "ecommerce_errors_total", "legendFormat": "Errors" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Traffic, Error Rates & Request Status",
      "type": "row"
    },
    {
      "id": 5,
      "title": "HTTP Traffic by Response Status (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(ecommerce_http_requests_total[1m])) by (status_code)", "legendFormat": "Status {{ status_code }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "id": 6,
      "title": "HTTP 5xx Error Rate Percentage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "(sum(rate(ecommerce_http_requests_total{status_code=~\"5..\"}[1m])) / (sum(rate(ecommerce_http_requests_total[1m])) > 0)) * 100",
          "legendFormat": "5xx Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }] },
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "⏱️ Latency Percentiles & Host Resource Utilization",
      "type": "row"
    },
    {
      "id": 7,
      "title": "API Latency Percentiles (p50, p90, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ecommerce_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p50 (Median)" },
        { "expr": "histogram_quantile(0.90, sum(rate(ecommerce_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.99, sum(rate(ecommerce_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "p99 (Tail Latency)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line" } } }
    },
    {
      "id": 8,
      "title": "Host CPU & Memory Saturation (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "Host CPU %" },
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "Host Memory %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 85 }] },
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "💾 Host Disk Space & Container Health",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Root Filesystem Utilization (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)", "legendFormat": "Disk Used %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 85 }] }
        }
      }
    },
    {
      "id": 10,
      "title": "Node.js Process Heap Saturation (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "ecommerce_process_resident_memory_bytes", "legendFormat": "Resident Memory (RSS)" },
        { "expr": "ecommerce_process_heap_used_bytes", "legendFormat": "Heap Memory Used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line" } } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["retailcorp", "ecommerce", "devops", "golden-signals", "sre"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "RetailCorp E-Commerce Production Observability",
  "uid": "retailcorp-ecommerce-prod",
  "version": 1
}
