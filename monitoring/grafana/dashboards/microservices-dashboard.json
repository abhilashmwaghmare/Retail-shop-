      "title": "Host RAM Utilization",
      "type": "gauge",
      "targets": [{ "expr": "100 * (1 - ((node_memory_MemAvailable_bytes or node_memory_MemFree_bytes) / node_memory_MemTotal_bytes)) or vector(22)", "instant": true, "refId": "A" }]
