      "title": "Throughput: Requests per Second by Microservice",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (service, job) (rate(http_requests_total[1m]))", "legendFormat": "{{service}} {{job}}", "refId": "A" }]
